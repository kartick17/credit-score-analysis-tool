{
  "realm": "credit-risk",
  "enabled": true,
  "displayName": "Credit Risk \u00b7 Local learning",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "OFFICER"
      },
      {
        "name": "CREDIT_MANAGER"
      },
      {
        "name": "PLATFORM_ADMIN"
      }
    ]
  },
  "clients": [
    {
      "clientId": "credit-risk-portal",
      "name": "Credit Risk Portal",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5173/sign-in",
        "http://127.0.0.1:5173/sign-in"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/sign-in##http://127.0.0.1:5173/sign-in"
      },
      "protocolMappers": [
        {
          "name": "staff roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "branch",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "branch_id",
            "claim.name": "branch_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "credit-risk-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "credit-risk-postman",
      "name": "Credit Risk API Client",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "staff roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "branch",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "branch_id",
            "claim.name": "branch_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "credit-risk-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "officer-one",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sample",
      "lastName": "Officer One",
      "email": "officer-one@example.invalid",
      "realmRoles": [
        "OFFICER"
      ],
      "attributes": {
        "branch_id": [
          "BR-001"
        ]
      }
    },
    {
      "username": "officer-two",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sample",
      "lastName": "Officer Two",
      "email": "officer-two@example.invalid",
      "realmRoles": [
        "OFFICER"
      ],
      "attributes": {
        "branch_id": [
          "BR-002"
        ]
      }
    },
    {
      "username": "manager-one",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sample",
      "lastName": "Manager One",
      "email": "manager-one@example.invalid",
      "realmRoles": [
        "CREDIT_MANAGER"
      ]
    },
    {
      "username": "admin-one",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sample",
      "lastName": "Admin One",
      "email": "admin-one@example.invalid",
      "realmRoles": [
        "PLATFORM_ADMIN"
      ]
    }
  ]
}
